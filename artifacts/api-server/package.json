{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development node ./build.mjs && pnpm run start",
    "build": "tsc --noEmit --skipLibCheck || true && node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.5.0",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.30.0",
    "express": "^5.0.0",
    "mongoose": "^8.12.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^20.11.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.24.0",
    "esbuild-plugin-pino": "^2.2.0",
    "pino-pretty": "^11.0.0",
    "thread-stream": "3.1.0",
    "typescript": "^5.4.0"
  }
}