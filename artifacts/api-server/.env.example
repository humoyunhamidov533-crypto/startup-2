# MongoDB Atlas yoki local MongoDB connection string
# Atlas misoli: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/kamuran-kabab
# Local misoli: mongodb://localhost:27017/kamuran-kabab
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/kamuran-kabab

# Express server port
PORT=3000

# (Ixtiyoriy) PostgreSQL - agar ishlatmasangiz o'chirib tashlang
# DATABASE_URL=postgresql://...
